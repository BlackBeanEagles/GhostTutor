# Every value is optional. With nothing set, Ghost Tutor runs fully local:
# JSON file storage, keyword search, browser voice, offline cloze questions.

PORT=3300

# --- Gemma (open-weight brain) ---
# Local:        ollama pull gemma3:4b && ollama pull nomic-embed-text
# DigitalOcean: point at your GPU Droplet running Ollama, e.g. http://<droplet-ip>:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b
# Tool-calling model for the Mastra agent (Gemma 3 can't call tools; Gemma 4 can)
AGENT_MODEL=gemma4:e2b-it-q4_K_M
EMBED_MODEL=nomic-embed-text
LLM_API_KEY=ollama
LLM_HOST_LABEL=local

# --- MongoDB Atlas: student memory, quiz history ---
MONGODB_URI=

# --- Tiger Data: pgvector hybrid search over notes + Timescale attempts table ---
DATABASE_URL=

# --- ElevenLabs: tutor voice + spoken answers ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- SerpApi: fresh web practice questions ---
SERPAPI_KEY=

# --- TabPFN: score prediction (pip install -r python/requirements.txt) ---
TABPFN_TOKEN=
PYTHON_BIN=python

# --- Sentry: agent tracing ---
SENTRY_DSN=

# --- Temporal: nightly durable study nudges (npm run worker) ---
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
GHOST_URL=http://localhost:3300
